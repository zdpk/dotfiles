#!/usr/bin/env bash

set -euo pipefail

token_found=0
for argument in "$@"; do
  if [ "$argument" = 'access_token=fixture-access-token' ]; then
    token_found=1
    break
  fi
done

if [ "$token_found" -ne 1 ]; then
  printf '%s\n' 'fixture access token was not passed to curl' >&2
  exit 1
fi

printf '%s\n' '{"email":"adc@example.com"}'
