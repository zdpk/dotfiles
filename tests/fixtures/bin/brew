#!/usr/bin/env bash

set -euo pipefail

: "${DOTFILES_TEST_STATE:?}"

case "${1:-} ${2:-}" in
  'list --cask')
    [ -f "$DOTFILES_TEST_STATE/cask-${3:-}" ]
    ;;
  'install --cask')
    # The cask is the last argument so options such as --adopt can precede it.
    printf '%s\n' "$*" >"$DOTFILES_TEST_STATE/cask-${!#}"
    ;;
  *)
    printf 'unexpected brew invocation: %s\n' "$*" >&2
    exit 2
    ;;
esac
