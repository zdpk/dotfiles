#!/usr/bin/env bash

set -euo pipefail

: "${DOTFILES_TEST_STATE:?}"

if [ "${1:-}" = "property" ] && [ "${2:-}" = "--get" ] && [ "${3:-}" = "UserKeyMapping" ]; then
  if [ -f "$DOTFILES_TEST_STATE/mapping" ]; then
    cat <<'EOF'
(
    {
        HIDKeyboardModifierMappingDst = 30064771181;
        HIDKeyboardModifierMappingSrc = 30064771303;
    },
    {
        HIDKeyboardModifierMappingDst = 30064771182;
        HIDKeyboardModifierMappingSrc = 30064771302;
    }
)
EOF
  else
    printf '%s\n' '(null)'
  fi
  exit 0
fi

if [ "${1:-}" = "property" ] && [ "${2:-}" = "--set" ]; then
  printf '%s\n' "${3:-}" | grep -q '0x7000000E7'
  printf '%s\n' "${3:-}" | grep -q '0x70000006D'
  printf '%s\n' "${3:-}" | grep -q '0x7000000E6'
  printf '%s\n' "${3:-}" | grep -q '0x70000006E'
  : >"$DOTFILES_TEST_STATE/mapping"
  exit 0
fi

printf 'unexpected hidutil invocation: %s\n' "$*" >&2
exit 2
