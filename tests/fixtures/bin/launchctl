#!/usr/bin/env bash

set -euo pipefail

: "${DOTFILES_TEST_STATE:?}"

label_from_service() {
  printf '%s\n' "${1##*/}"
}

label_from_plist() {
  basename "$1" .plist
}

case "${1:-}" in
  print)
    label="$(label_from_service "${2:-}")"
    [ -f "$DOTFILES_TEST_STATE/launch-agent-$label" ]
    ;;
  bootstrap)
    [ -f "${3:-}" ]
    label="$(label_from_plist "${3:-}")"
    : >"$DOTFILES_TEST_STATE/launch-agent-$label"
    ;;
  bootout)
    label="$(label_from_service "${2:-}")"
    rm -f "$DOTFILES_TEST_STATE/launch-agent-$label"
    ;;
  *)
    printf 'unexpected launchctl invocation: %s\n' "$*" >&2
    exit 2
    ;;
esac
