#!/usr/bin/env bash

set -euo pipefail

: "${DOTFILES_TEST_STATE:?}"

# The stock macOS state is a disabled shortcut still bound to Control-Space.
print_symbolic_hotkeys() {
  local hotkey_id enabled key_code modifiers
  cat <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>AppleSymbolicHotKeys</key>
  <dict>
EOF
  for hotkey_id in 60 61; do
    enabled=false; key_code=49; modifiers=262144
    if [ "$hotkey_id" = 61 ]; then enabled=true; key_code=79; modifiers=8388608; fi
    if [ -f "$DOTFILES_TEST_STATE/hotkey-$hotkey_id" ]; then
      read -r enabled key_code modifiers <"$DOTFILES_TEST_STATE/hotkey-$hotkey_id"
    fi
    cat <<EOF
    <key>$hotkey_id</key>
    <dict>
      <key>enabled</key>
      <$enabled/>
      <key>value</key>
      <dict>
        <key>parameters</key>
        <array>
          <real>65535.0</real>
          <real>$key_code.0</real>
          <real>$modifiers.0</real>
        </array>
        <key>type</key>
        <string>standard</string>
      </dict>
    </dict>
EOF
  done
  cat <<'EOF'
  </dict>
</dict>
</plist>
EOF
}

# The module writes the entry as an XML plist fragment so the value types match
# what macOS itself writes, so the fixture parses that rather than old-style
# plist syntax.
record_symbolic_hotkey() {
  local value="$1"
  local hotkey_id="$2"
  local integers
  local enabled

  case "$value" in
    *"<true/>"*)
      enabled=true
      ;;
    *"<false/>"*)
      enabled=false
      ;;
    *)
      printf 'unexpected hotkey value: %s\n' "$value" >&2
      exit 2
      ;;
  esac

  integers="$(printf '%s\n' "$value" \
    | grep -o '<integer>[0-9]*</integer>' \
    | sed 's/[^0-9]//g')"

  printf '%s %s %s\n' \
    "$enabled" \
    "$(printf '%s\n' "$integers" | sed -n '2p')" \
    "$(printf '%s\n' "$integers" | sed -n '3p')" \
    >"$DOTFILES_TEST_STATE/hotkey-$hotkey_id"
}

case "${1:-}:${2:-}:${3:-}" in
  # Absent state stands in for a fresh machine, where the key is either unset
  # or left at the macOS default of on.
  read:-g:*Automatic*)
    [ -f "$DOTFILES_TEST_STATE/global-$3" ] || exit 1
    cat "$DOTFILES_TEST_STATE/global-$3"
    ;;
  write:-g:*Automatic*)
    [ "${4:-}" = "-bool" ]
    case "${5:-}" in
      true)
        printf '%s\n' '1' >"$DOTFILES_TEST_STATE/global-$3"
        ;;
      false)
        printf '%s\n' '0' >"$DOTFILES_TEST_STATE/global-$3"
        ;;
      *)
        printf 'unexpected boolean: %s\n' "${5:-}" >&2
        exit 2
        ;;
    esac
    ;;
  export:com.apple.symbolichotkeys:-)
    print_symbolic_hotkeys
    ;;
  write:com.apple.symbolichotkeys:AppleSymbolicHotKeys)
    [ "${4:-}" = "-dict-add" ]
    case "${5:-}" in 60 | 61) ;; *) exit 2 ;; esac
    record_symbolic_hotkey "${6:-}" "$5"
    ;;
  read:com.apple.HIToolbox:AppleFnUsageType)
    [ -f "$DOTFILES_TEST_STATE/globe" ] || exit 1
    cat "$DOTFILES_TEST_STATE/globe"
    ;;
  write:com.apple.HIToolbox:AppleFnUsageType)
    [ "${4:-}" = "-int" ] && [ "${5:-}" = 1 ]
    printf '%s\n' 1 >"$DOTFILES_TEST_STATE/globe"
    ;;
  *)
    printf 'unexpected defaults invocation: %s\n' "$*" >&2
    exit 2
    ;;
esac
