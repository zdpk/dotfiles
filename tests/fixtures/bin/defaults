#!/usr/bin/env bash

set -euo pipefail

: "${DOTFILES_TEST_STATE:?}"

HOTKEY_STATE="$DOTFILES_TEST_STATE/hotkey-60"
PERIOD_STATE="$DOTFILES_TEST_STATE/period-substitution"

# The stock macOS state is a disabled shortcut still bound to Control-Space.
print_symbolic_hotkeys() {
  local enabled=false
  local key_code=49
  local modifiers=262144

  if [ -f "$HOTKEY_STATE" ]; then
    read -r enabled key_code modifiers <"$HOTKEY_STATE"
  fi

  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>AppleSymbolicHotKeys</key>
  <dict>
    <key>60</key>
    <dict>
      <key>enabled</key>
      <$enabled/>
      <key>value</key>
      <dict>
        <key>parameters</key>
        <array>
          <integer>65535</integer>
          <integer>$key_code</integer>
          <integer>$modifiers</integer>
        </array>
        <key>type</key>
        <string>standard</string>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
EOF
}

# The module writes the entry as an XML plist fragment so the value types match
# what macOS itself writes, so the fixture parses that rather than old-style
# plist syntax.
record_symbolic_hotkey() {
  local value="$1"
  local integers
  local enabled

  case "$value" in
    *"<true/>"*)
      enabled=true
      ;;
    *"<false/>"*)
      enabled=false
      ;;
    *)
      printf 'unexpected hotkey value: %s\n' "$value" >&2
      exit 2
      ;;
  esac

  integers="$(printf '%s\n' "$value" \
    | grep -o '<integer>[0-9]*</integer>' \
    | sed 's/[^0-9]//g')"

  printf '%s %s %s\n' \
    "$enabled" \
    "$(printf '%s\n' "$integers" | sed -n '2p')" \
    "$(printf '%s\n' "$integers" | sed -n '3p')" \
    >"$HOTKEY_STATE"
}

case "${1:-}:${2:-}:${3:-}" in
  # Absent state stands in for a fresh machine, where the key is either unset
  # or left at the macOS default of on.
  read:-g:NSAutomaticPeriodSubstitutionEnabled)
    [ -f "$PERIOD_STATE" ] || exit 1
    cat "$PERIOD_STATE"
    ;;
  write:-g:NSAutomaticPeriodSubstitutionEnabled)
    [ "${4:-}" = "-bool" ]
    case "${5:-}" in
      true)
        printf '%s\n' '1' >"$PERIOD_STATE"
        ;;
      false)
        printf '%s\n' '0' >"$PERIOD_STATE"
        ;;
      *)
        printf 'unexpected boolean: %s\n' "${5:-}" >&2
        exit 2
        ;;
    esac
    ;;
  export:com.apple.symbolichotkeys:-)
    print_symbolic_hotkeys
    ;;
  write:com.apple.symbolichotkeys:AppleSymbolicHotKeys)
    [ "${4:-}" = "-dict-add" ]
    [ "${5:-}" = "60" ]
    record_symbolic_hotkey "${6:-}"
    ;;
  *)
    printf 'unexpected defaults invocation: %s\n' "$*" >&2
    exit 2
    ;;
esac
