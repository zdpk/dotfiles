#!/usr/bin/env bash

set -euo pipefail

: "${DOTFILES_TEST_STATE:?}"

HOTKEY_STATE="$DOTFILES_TEST_STATE/hotkey-60"

# The stock macOS state is a disabled shortcut still bound to Control-Space.
print_symbolic_hotkeys() {
  local enabled=false
  local key_code=49
  local modifiers=262144

  if [ -f "$HOTKEY_STATE" ]; then
    read -r enabled key_code modifiers <"$HOTKEY_STATE"
  fi

  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>AppleSymbolicHotKeys</key>
  <dict>
    <key>60</key>
    <dict>
      <key>enabled</key>
      <$enabled/>
      <key>value</key>
      <dict>
        <key>parameters</key>
        <array>
          <integer>65535</integer>
          <integer>$key_code</integer>
          <integer>$modifiers</integer>
        </array>
        <key>type</key>
        <string>standard</string>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
EOF
}

record_symbolic_hotkey() {
  local value="$1"
  local parameters
  local enabled

  case "$value" in
    *enabled=1*)
      enabled=true
      ;;
    *enabled=0*)
      enabled=false
      ;;
    *)
      printf 'unexpected hotkey value: %s\n' "$value" >&2
      exit 2
      ;;
  esac

  parameters="${value#*parameters=(}"
  parameters="${parameters%%)*}"

  printf '%s %s %s\n' \
    "$enabled" \
    "$(printf '%s\n' "$parameters" | cut -d, -f2)" \
    "$(printf '%s\n' "$parameters" | cut -d, -f3)" \
    >"$HOTKEY_STATE"
}

case "${1:-}:${2:-}:${3:-}" in
  export:com.apple.symbolichotkeys:-)
    print_symbolic_hotkeys
    ;;
  write:com.apple.symbolichotkeys:AppleSymbolicHotKeys)
    [ "${4:-}" = "-dict-add" ]
    [ "${5:-}" = "60" ]
    record_symbolic_hotkey "${6:-}"
    ;;
  *)
    printf 'unexpected defaults invocation: %s\n' "$*" >&2
    exit 2
    ;;
esac
