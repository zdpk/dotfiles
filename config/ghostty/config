#################################################
# font
#################################################
font-size = 17
font-synthetic-style = true
adjust-cell-width = 0%

# The family lives beside this file rather than in it, so a machine can pick a
# face without editing shared configuration. bootstrap.sh links font.conf to
# one of config/ghostty/fonts/*.conf; the leading ? keeps Ghostty quiet on a
# machine that has not run the setup yet. The include comes last so a profile
# can override the sizing above.
config-file = ?font.conf

#################################################
# window
#################################################
window-theme = dark
window-colorspace = display-p3
window-padding-x = 10,10
window-padding-y = 10,10

background-opacity = 0.7
background-blur = true

# The built-in theme name, not a path into Ghostty.app, so the same file works
# on a Linux install.
theme = tokyonight

#################################################
# shell-integration
#################################################
shell-integration = none
shell-integration-features = cursor, sudo, no-title

#################################################
# mouse
#################################################
mouse-scroll-multiplier = 0.7

#################################################
# keybindings
#################################################
keybind = shift+enter=text:\n
keybind = ctrl+d=scroll_page_down
keybind = ctrl+u=scroll_page_up
